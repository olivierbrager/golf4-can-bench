[Unit]
Description=Golf4 CAN TX emulator
After=network-online.target can0.service
Wants=network-online.target

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__REPO_DIR__
ExecStart=__REPO_DIR__/.venv/bin/python -m uvicorn can_tx_emulator:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target

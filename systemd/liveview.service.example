[Unit]
Description=Golf4 CAN Liveview (Base clean)
After=can0.service

[Service]
Type=simple
User=__APP_USER__
WorkingDirectory=__REPO_DIR__
EnvironmentFile=/etc/golf4/liveview.env
ExecStart=__REPO_DIR__/.venv/bin/python -m uvicorn liveview:app --host ${HOST} --port ${PORT}
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
